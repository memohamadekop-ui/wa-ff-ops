{
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "wa-ff-ops-be",
          "region": "asia-southeast1",
          "pinTag": true
        }
      }
    ]
  }
}
